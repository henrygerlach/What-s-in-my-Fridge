# Supabase project settings (Project Settings > API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional: only needed for `npm run preview` behind a reverse proxy that
# keeps a non-localhost hostname in the Host header (e.g. `tailscale serve`).
# See the README section "Install on an iPhone".
# VITE_ALLOWED_HOST=your-device.your-tailnet.ts.net

# Set as a secret on the Supabase Edge Function, not here:
# supabase secrets set ANTHROPIC_API_KEY=your-anthropic-api-key
